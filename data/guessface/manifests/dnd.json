      "usesSeed": false,
      "injectionTarget": "none"
    },
    "imageGeneration": {
      "deployment": "gpt-image-2",
      "styleTagVariantCount": 1,
      "requiresSecondPassCompose": false
    }
  },
  "captionParse": {
    "visionDeployment": "groovepop-vision",
    "outputShape": "single_text_field"
  },
  "reveal": {
    "sequence": "standard",
    "surfaceBehavior": {}
  },
  "hooks": {
    "pairing": "default",
    "captionParsing": "default",
    "revealSequencing": "default"
  }
}
